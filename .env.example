# Root aggregate — copy into real .env files; never commit secrets

# --- Shared ---
NODE_ENV=development

# --- API / worker (apps/api) ---
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DATABASE_URL=postgresql://t360:t360@localhost:5432/t360?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
PAYMENT_PROVIDER=mock
NOTIFICATION_PROVIDER=mock
AI_PROVIDER=mock
FASHION_AI_PROVIDER=disabled
# Path A (stills): FASHION_AI_PROVIDER=fashn + FASHN_API_KEY on api and worker
# FASHN_API_KEY=
# Customer TRY ME virtual try-on (reuses FASHION_AI_* + Cloudinary; no second AI stack)
TRY_ON_ENABLED=true
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
POS_PROVIDER=mock
SEARCH_PROVIDER=postgres
# SENTRY_DSN=
# GIT_SHA=
# APP_VERSION=0.0.0
# ALLOW_MOCK_PROVIDERS=1
# Production: set real providers (razorpay, cloudinary, openai/fashn, sms) — see docs/deployment/ENV.md
# SEED_ADMIN_PASSWORD=  # required when seeding production admin

# Storefront social (optional — section hidden when unset)
# STOREFRONT_INSTAGRAM_URL=
# STOREFRONT_FACEBOOK_URL=
# STOREFRONT_YOUTUBE_URL=

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_E164=919876543210
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# NEXT_PUBLIC_SENTRY_DSN=

# --- Admin (apps/admin) ---
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# NEXT_PUBLIC_SENTRY_DSN=
