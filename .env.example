# Root aggregate — copy into real .env files; never commit secrets

# --- Shared ---
NODE_ENV=development

# --- API / worker (apps/api) ---
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DATABASE_URL=postgresql://t360:t360@localhost:5432/t360?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
PAYMENT_PROVIDER=mock
NOTIFICATION_PROVIDER=mock
AI_PROVIDER=mock
POS_PROVIDER=mock
SEARCH_PROVIDER=postgres
# SENTRY_DSN=
# GIT_SHA=
# APP_VERSION=0.0.0
# ALLOW_MOCK_PROVIDERS=1

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_E164=919876543210
NEXT_PUBLIC_RAZORPAY_KEY_ID=
