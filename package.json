{
  "name": "t360",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm --filter @t360/api test",
    "dev:web": "pnpm --filter @t360/web dev",
    "dev:admin": "pnpm --filter @t360/admin dev",
    "dev:api": "pnpm --filter @t360/api dev",
    "worker": "pnpm --filter @t360/api worker",
    "prisma:generate": "pnpm --filter @t360/database generate",
    "prisma:migrate": "pnpm --filter @t360/database migrate",
    "prisma:seed": "pnpm --filter @t360/database seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "test:e2e:smoke": "playwright test",
    "csv:dry-run": "node scripts/launch/csv-dry-run.mjs",
    "preflight:env": "node scripts/launch/preflight-env.mjs",
    "build:mobile:apk": "powershell -ExecutionPolicy Bypass -File scripts/launch/build-mobile-apk.ps1",
    "regen:mobile:splash": "cd apps/mobile && dart run flutter_native_splash:create && python tool/fix_splash_backgrounds.py",
    "regen:mobile:icons": "cd apps/mobile && dart run flutter_launcher_icons",
    "regen:mobile:branding": "python apps/mobile/tool/process_uploaded_branding.py && pnpm regen:mobile:splash && pnpm regen:mobile:icons",
    "regen:mobile:branding:generated": "python apps/mobile/tool/generate_branding_assets.py && pnpm regen:mobile:splash && pnpm regen:mobile:icons",
    "regen:web:branding": "python apps/web/tool/process_web_branding.py",
    "validate:catalog": "node apps/api/scripts/validate-catalog.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
