generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String?   @db.Uuid
  email        String?   @unique
  mobile       String?   @unique
  passwordHash String?
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String?
  status       String    @default("active")
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  sessions  Session[]
  roles     UserRole[]
  customer  Customer?
  employee  Employee?
  auditLogs AuditLog[]
  notifications Notification[]
  deviceTokens DeviceToken[]
  notificationPreference NotificationPreference?
  aiConversations AIConversation[]
  aiGeneratedImages AiGeneratedImage[]
  aiFashionUsage    AiFashionUsage[]
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  familyId         String    @db.Uuid
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([familyId])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @db.Uuid
  userId    String    @unique @db.Uuid
  name      String?
  gender    String?
  dateOfBirth DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses    Address[]
  wishlistItems WishlistItem[]
  cart         Cart?
  orders       Order[]
  loyaltyAccount LoyaltyAccount?
  couponUsages CouponUsage[]
  abandonedReminders AbandonedCartReminder[]
}

model Address {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @db.Uuid
  label      String    @default("Home")
  name       String
  phone      String
  line1      String
  line2      String    @default("")
  city       String
  state      String
  pincode    String
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  variantId  String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([customerId, variantId])
  @@index([customerId])
  @@index([variantId])
}

model Employee {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String?   @db.Uuid
  userId       String    @unique @db.Uuid
  name         String
  employeeCode String?   @unique
  branchId     String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([employeeCode])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique
  requestHash  String
  responseBody Json?
  statusCode   Int?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @db.Uuid
  parentId  String?   @db.Uuid
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([status])
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @db.Uuid
  name      String
  slug      String    @unique
  logoUrl   String?
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]

  @@index([status])
}

model Product {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @db.Uuid
  categoryId  String    @db.Uuid
  brandId     String?   @db.Uuid
  name        String
  slug        String    @unique
  description String    @default("")
  status      String    @default("draft")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  category   Category               @relation(fields: [categoryId], references: [id])
  brand      Brand?                 @relation(fields: [brandId], references: [id])
  variants   ProductVariant[]
  images     ProductImage[]
  attributes ProductAttributeValue[]
  aiGeneratedImages AiGeneratedImage[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([createdAt])
}

model ProductVariant {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @db.Uuid
  sku       String    @unique
  barcode   String?   @unique
  price     Decimal   @db.Decimal(12, 2)
  cost      Decimal?  @db.Decimal(12, 2)
  salePrice Decimal?  @db.Decimal(12, 2)
  attributes Json     @default("{}")
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images  ProductImage[]
  inventory Inventory[]
  reservations StockReservation[]
  transferLines StockTransferLine[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([productId])
  @@index([status])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  variantId String?  @db.Uuid
  url       String
  publicId  String?
  alt       String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
}

model AttributeDefinition {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  type      String   @default("text")
  options   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values ProductAttributeValue[]
}

model ProductAttributeValue {
  id          String @id @default(uuid()) @db.Uuid
  productId   String @db.Uuid
  attributeId String @db.Uuid
  value       String

  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([attributeId])
}

model Branch {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String?   @db.Uuid
  code               String    @unique
  name               String
  address            String    @default("")
  phone              String?
  hours              Json?
  status             String    @default("active")
  managerEmployeeId  String?   @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  warehouses   Warehouse[]
  inventory    Inventory[]
  reservations StockReservation[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")

  @@index([status])
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  code      String
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, code])
  @@index([branchId])
}

model Inventory {
  id                String   @id @default(uuid()) @db.Uuid
  branchId          String   @db.Uuid
  variantId         String   @db.Uuid
  physicalQty       Int      @default(0)
  reservedQty       Int      @default(0)
  version           Int      @default(0)
  lowStockThreshold Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  branch  Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([branchId, variantId])
  @@index([variantId])
  @@index([branchId])
}

model InventoryMovement {
  id            String   @id @default(uuid()) @db.Uuid
  branchId      String   @db.Uuid
  variantId     String   @db.Uuid
  type          String
  qtyDelta      Int
  physicalAfter Int?
  reservedAfter Int?
  actorId       String?  @db.Uuid
  reason        String?
  transferId    String?  @db.Uuid
  reservationId String?  @db.Uuid
  createdAt     DateTime @default(now())

  @@index([branchId, variantId])
  @@index([createdAt])
  @@index([type])
}

model StockReservation {
  id             String   @id @default(uuid()) @db.Uuid
  branchId       String   @db.Uuid
  variantId      String   @db.Uuid
  qty            Int
  status         String   @default("active")
  expiresAt      DateTime
  cartOrOrderRef String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch  Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([branchId, variantId])
}

model StockTransfer {
  id           String   @id @default(uuid()) @db.Uuid
  fromBranchId String   @db.Uuid
  toBranchId   String   @db.Uuid
  status       String   @default("pending")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  completedAt  DateTime?

  fromBranch Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch              @relation("TransferTo", fields: [toBranchId], references: [id])
  lines      StockTransferLine[]

  @@index([status])
}

model StockTransferLine {
  id         String @id @default(uuid()) @db.Uuid
  transferId String @db.Uuid
  variantId  String @db.Uuid
  qty        Int

  transfer StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@index([transferId])
}

model Cart {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @unique @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]
  abandonedReminders AbandonedCartReminder[]
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @db.Uuid
  variantId String   @db.Uuid
  branchId  String?  @db.Uuid
  qty       Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

model Order {
  id                String    @id @default(uuid()) @db.Uuid
  number            String    @unique
  customerId        String    @db.Uuid
  status            String    @default("Pending")
  fulfillment       String
  branchId          String?   @db.Uuid
  addressSnapshot   Json?
  subtotal          Decimal   @db.Decimal(12, 2)
  shippingFee       Decimal   @db.Decimal(12, 2) @default(0)
  discount          Decimal   @db.Decimal(12, 2) @default(0)
  tax               Decimal   @db.Decimal(12, 2) @default(0)
  total             Decimal   @db.Decimal(12, 2)
  currency          String    @default("INR")
  pickupCode        String?
  pickupVerifiedAt  DateTime?
  reservationIds    Json?
  idempotencyKey    String?   @unique
  paymentMethod     String
  couponId          String?   @db.Uuid
  loyaltyPointsRedeemed Int   @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customer Customer     @relation(fields: [customerId], references: [id])
  coupon   Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  events   OrderEvent[]
  payments Payment[]
  refunds  Refund[]
  shipments Shipment[]
  couponUsages CouponUsage[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([couponId])
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  variantId String  @db.Uuid
  sku       String
  name      String
  qty       Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)
  branchId  String? @db.Uuid

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model OrderEvent {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  fromStatus String?
  toStatus   String
  actorId    String?  @db.Uuid
  note       String?
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @db.Uuid
  provider          String
  providerOrderId   String?
  providerPaymentId String?
  method            String
  status            String   @default("pending")
  amount            Decimal  @db.Decimal(12, 2)
  raw               Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@index([providerOrderId])
}

model Refund {
  id               String   @id @default(uuid()) @db.Uuid
  paymentId        String   @db.Uuid
  orderId          String   @db.Uuid
  amount           Decimal  @db.Decimal(12, 2)
  status           String   @default("pending")
  providerRefundId String?
  idempotencyKey   String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Shipment {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  status     String   @default("pending")
  carrier    String?
  trackingNo String?
  fee        Decimal  @db.Decimal(12, 2) @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model WebhookEvent {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
  @@index([createdAt])
}

model Coupon {
  id               String    @id @default(uuid()) @db.Uuid
  code             String    @unique
  type             String
  value            Decimal   @db.Decimal(12, 2)
  minOrder         Decimal   @db.Decimal(12, 2) @default(0)
  maxUses          Int?
  perCustomerLimit Int       @default(1)
  startsAt         DateTime?
  endsAt           DateTime?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  usages CouponUsage[]
  orders Order[]

  @@index([active])
}

model CouponUsage {
  id         String   @id @default(uuid()) @db.Uuid
  couponId   String   @db.Uuid
  customerId String   @db.Uuid
  orderId    String   @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId])
  @@index([couponId])
  @@index([customerId])
}

model LoyaltyAccount {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String   @unique @db.Uuid
  pointsBalance Int      @default(0)
  tier          String   @default("standard")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @db.Uuid
  delta        Int
  reason       String
  orderId      String?  @db.Uuid
  balanceAfter Int
  createdAt    DateTime @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([orderId])
}

model NotificationTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  code      String
  channel   String
  locale    String   @default("en")
  subject   String?
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, channel, locale])
  @@index([code])
}

model Notification {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  channel           String
  templateCode      String
  to                String
  status            String    @default("queued")
  providerMessageId String?
  payload           Json?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model DeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  token      String   @unique
  platform   String
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  marketingEmail     Boolean  @default(true)
  marketingSms       Boolean  @default(true)
  marketingPush      Boolean  @default(true)
  marketingWhatsapp  Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Segment {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  rules     Json
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  campaigns Campaign[]

  @@index([active])
}

model Campaign {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  status       String    @default("draft")
  channels     Json
  segmentId    String?   @db.Uuid
  couponCode   String?
  subject      String?
  body         String
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  segment    Segment?            @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  recipients CampaignRecipient[]

  @@index([status])
}

model CampaignRecipient {
  id             String   @id @default(uuid()) @db.Uuid
  campaignId     String   @db.Uuid
  userId         String   @db.Uuid
  status         String   @default("pending")
  notificationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([status])
}

model AbandonedCartReminder {
  id         String   @id @default(uuid()) @db.Uuid
  cartId     String   @db.Uuid
  customerId String   @db.Uuid
  wave       Int      @default(1)
  sentAt     DateTime @default(now())
  createdAt  DateTime @default(now())

  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([cartId, wave])
  @@index([customerId])
  @@index([sentAt])
}

model SocialPost {
  id        String    @id @default(uuid()) @db.Uuid
  platform  String
  title     String
  body      String
  mediaUrl  String?
  status    String    @default("draft")
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([platform])
}

model AIConversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  audience  String   // customer | admin
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, audience])
  @@index([updatedAt])
}

model AIMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  role           String   // user | assistant | tool
  content        String
  toolName       String?
  toolPayload    Json?
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Integration {
  id             String    @id @default(uuid()) @db.Uuid
  provider       String
  kind           String
  status         String    @default("disabled")
  credentialsRef String?
  syncCursor     Json?
  lastSyncAt     DateTime?
  lastError      String?
  config         Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([provider, kind])
  @@index([kind, status])
}

model SearchSynonym {
  id        String    @id @default(uuid()) @db.Uuid
  term      String    @unique
  aliases   Json
  locale    String    @default("en")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([active])
  @@index([locale])
}

/// Fashion model library for AI Fashion Studio
model AiFashionModel {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  gender          String
  ageRange        String?
  style           String?
  bodyType        String?
  skinTone        String?
  hairStyle       String?
  imageUrl        String
  publicId        String?
  provider        String   @default("fashn")
  providerModelId String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  generatedImages AiGeneratedImage[]

  @@index([isActive])
  @@index([gender])
  @@index([createdAt])
}

/// AI Fashion generation jobs / results
model AiGeneratedImage {
  id              String    @id @default(uuid()) @db.Uuid
  productId       String?   @db.Uuid
  modelId         String?   @db.Uuid
  type            String
  /// QUEUED | PROCESSING | COMPLETED | FAILED | CANCELLED
  status          String    @default("QUEUED")
  inputImageUrl   String
  personImageUrl  String?
  outputImageUrl  String?
  outputPublicId  String?
  provider        String
  providerJobId   String?
  prompt          String?
  params          Json      @default("{}")
  error           String?
  errorDetail     String?
  approvedAt      DateTime?
  /// primary | gallery
  approvedAs      String?
  createdBy       String    @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?

  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  model   AiFashionModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  creator User            @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  usage   AiFashionUsage?

  @@index([status, createdAt])
  @@index([productId])
  @@index([createdBy])
  @@index([providerJobId])
  @@index([type, status])
  @@index([modelId])
}

/// Usage / cost ledger for AI Fashion generations
model AiFashionUsage {
  id             String   @id @default(uuid()) @db.Uuid
  provider       String
  generationType String
  productId      String?  @db.Uuid
  userId         String   @db.Uuid
  jobId          String   @unique @db.Uuid
  creditsUsed    Int?
  status         String
  createdAt      DateTime @default(now())

  job  AiGeneratedImage @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([provider, createdAt])
  @@index([generationType, createdAt])
  @@index([status, createdAt])
}
